{
  "name": "wtfmedia-edge",
  "private": true,
  "version": "0.3.2-alpha.1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "node -e \"console.error('Refusing ambiguous deploy. Use deploy:staging or deploy:production.'); process.exit(1)\"",
    "deploy:staging": "node ../scripts/wrangler-profile.mjs wtfmedia deploy --config wrangler.jsonc --env staging",
    "deploy:production": "node ../scripts/wrangler-profile.mjs wtfmedia deploy --config wrangler.jsonc",
    "types": "wrangler types",
    "test": "node scripts/test.mjs"
  },
  "devDependencies": {
    "jose": "6.2.10",
    "wrangler": "4.95.0"
  }
}
