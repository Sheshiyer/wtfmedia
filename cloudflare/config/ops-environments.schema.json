      "properties": {
        "d1_binding": { "const": "OPS_DB_STAGING" },
        "clerk_instance_ref": { "const": "OPS_CLERK_INSTANCE_STAGING" },
        "clerk_authorized_parties_ref": { "const": "OPS_CLERK_AUTHORIZED_PARTIES_STAGING" },
