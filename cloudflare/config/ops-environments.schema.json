      "properties": {
        "d1_binding": { "const": "OPS_DB_PRODUCTION" },
        "clerk_instance_ref": { "const": "OPS_CLERK_INSTANCE_PRODUCTION" },
        "clerk_authorized_parties_ref": { "const": "OPS_CLERK_AUTHORIZED_PARTIES_PRODUCTION" },
        "origin_proof_secret_ref": { "const": "OPS_ORIGIN_PROOF_PRODUCTION" },
        "cache_namespace_ref": { "const": "OPS_CACHE_PRODUCTION" },
