# python / data (root extraction dir only — NOT web/src/data, which the app needs)
/data/
__pycache__/
*.pyc
.venv/
.themes_cache/
web/src/data/connections.entities.json

# node / next (web app has its own .gitignore too)
node_modules/
.next/
out/

# internal planning / context — never publish
PRD.md
PRODUCT.md

# vercel + env + os
.vercel/
.env
.env*.local
*.log
.DS_Store
.vercel
.playwright-cli/

# ephemeral multi-agent orchestration records; may contain prompts and machine-local paths
.agents/

# Cloudflare local runtime and generated bindings
cloudflare/.wrangler/
cloudflare/worker-configuration.d.ts
# Root-level wrangler runtime cache (not the cloudflare/ workspace)
.wrangler/

# machine-local Temperance runtime receipts (regenerate with project init)
.temperance/project.json
.temperance/manifest.json
.runtime/preflight/
.planning/NEXT-WAVE.json
.planning/ORCHESTRATION.json

# machine-local Superset tool state (holds absolute paths and account ids)
.superset/

# planning state backups (regenerate via GSD, do not commit)
.planning/STATE.md.bak
.planning/STATE.md.bak-*

# local/private Phase 3 source material and unverified generated receipts
web/src/data/catalog-snapshot.json
web/tests/security/phase3-threat-results/
.planning/phases/03-episode-ingestion-provenance-spine/03-02-SUMMARY.md
.worktrees/
