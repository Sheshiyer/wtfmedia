{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wtfmedia-research-staging",
  "account_id": "8f380cb5640467030b647e12773efb46",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {"enabled": true, "traces": {"enabled": true}},
  "containers": [{"class_name":"ResearchContainer", "image":"registry.cloudflare.com/8f380cb5640467030b647e12773efb46/wtfmedia-research-staging@sha256:92f4eaa147999d4bd37dc83f8aa5798b1f9633b73f89474b55cf1bceb20b4ce1", "instance_type":"standard-1", "max_instances":1}],
  "durable_objects": {"bindings":[{"name":"RUNNER","class_name":"ResearchContainer"},{"name":"STATE","class_name":"ResearchState"}]},
  "migrations": [{"tag":"v1","new_sqlite_classes":["ResearchContainer","ResearchState"]}],
  "triggers": {"crons":["* * * * *"]}
}
