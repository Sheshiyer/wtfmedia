{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wtfmedia-research",
  "account_id": "8f380cb5640467030b647e12773efb46",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "vars": {"RESEARCH_NAMESPACE": "production"},
  "workers_dev": true,
  "preview_urls": false,
  "observability": {"enabled": true, "traces": {"enabled": true}},
  "containers": [{"class_name":"ResearchContainer", "image":"registry.cloudflare.com/8f380cb5640467030b647e12773efb46/wtfmedia-research@sha256:8f4f1feacd40699f75ddba6936dd48729c089ba697316d0e469fc3d1a112f484", "instance_type":"standard-1", "max_instances":1, "constraints":{"jurisdiction":"us"}}],
  "durable_objects": {"bindings":[{"name":"RUNNER","class_name":"ResearchContainer"},{"name":"STATE","class_name":"ResearchState"}]},
  "migrations": [{"tag":"v1","new_sqlite_classes":["ResearchContainer","ResearchState"]}],
  "triggers": {"crons":["* * * * *"]}
}
