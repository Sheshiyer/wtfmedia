{
  "name": "wtfmedia-web",
  "version": "0.1.3",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:ops": "WTF_PUBLIC_UI_VARIANT=migrated WTFMEDIA_OPS_ORIGIN_PROOF=phase2-e2e-test-key WTFMEDIA_OPS_LOCAL_ROLE=super_admin next dev",
    "build": "next build",
    "start": "next start",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "npm run cf:build && wrangler dev --config wrangler.jsonc",
    "cf:typegen": "wrangler types --config wrangler.jsonc --env-interface CloudflareEnv",
    "cf:deploy": "npm run cf:build && wrangler deploy --config wrangler.jsonc",
    "cf:deploy:9d9d": "npm run cf:build && env -u CF_API_TOKEN -u CLOUDFLARE_API_TOKEN -u CF_ACCOUNT_ID -u CLOUDFLARE_ACCOUNT_ID wrangler --profile 9d9d deploy --config wrangler.jsonc",
    "cf:deploy:wtfmedia": "npm run cf:build && env -u CF_API_TOKEN -u CLOUDFLARE_API_TOKEN -u CF_ACCOUNT_ID -u CLOUDFLARE_ACCOUNT_ID wrangler --profile wtfmedia deploy --config wrangler.jsonc",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:unit": "node scripts/test-unit.mjs",
    "test:contracts": "vitest run --project=contracts",
    "test:components": "vitest run --project=storybook",
    "build:storybook": "storybook build",
    "test:browser": "playwright test --project=phase1-chromium --grep-invert @visual",
    "test:a11y": "playwright test --project=phase1-chromium --grep @a11y",
    "test:visual": "playwright test --project=phase1-chromium --grep @visual",
    "test:privacy": "node tests/privacy/scan.mjs",
    "test:performance": "lhci collect --config=./lighthouserc.cjs && lhci upload --config=./lighthouserc.cjs",
    "test:rollback": "node tests/rollback/verify.mjs",
    "verify:phase1": "node scripts/verify-phase1.mjs",
    "verify:phase2": "node scripts/verify-phase2.mjs",
    "test:phase2:threat": "node scripts/run-phase2-threat.mjs --plan 02-01 --task 1",
    "merge:phase2:threat": "node scripts/lib/phase2-threat-results.mjs --check-definitions"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "eslint-config-next": "15.5.24",
    "motion": "12.23.24",
    "next": "15.5.24",
    "ogl": "^1.0.11",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-markdown": "9.0.1",
    "remark-gfm": "4.0.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@lhci/cli": "0.15.1",
    "@opennextjs/cloudflare": "1.20.4",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "10.5.9",
    "@storybook/addon-vitest": "10.5.9",
    "@storybook/nextjs-vite": "10.5.9",
    "@types/node": "22.12.0",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "@vitest/browser-playwright": "4.1.11",
    "autoprefixer": "10.4.20",
    "eslint": "9.39.5",
    "postcss": "8.5.1",
    "storybook": "10.5.9",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vite": "8.2.1",
    "vitest": "4.1.11",
    "wrangler": "4.125.0"
  }
}
